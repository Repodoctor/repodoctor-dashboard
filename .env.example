# Never put SUPABASE_SERVICE_ROLE_KEY in the Angular app.
# Copy to .env for local development. Cloudflare Pages: set the same NG_APP_* build vars.
# Production: public HTTPS URL of the Coolify-hosted gateway (usually behind Cloudflare).

NG_APP_GATEWAY_URL=http://127.0.0.1:43111
NG_APP_SUPABASE_URL=
NG_APP_SUPABASE_ANON_KEY=
